{
  "name": "niva",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && node scripts/write-build-info.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "preview": "node scripts/serve.mjs",
    "format": "prettier --write src scripts tests *.json *.ts README.md docs/implementation.md .github/workflows/ci.yml",
    "format:check": "prettier --check src scripts tests *.json *.ts README.md docs/implementation.md .github/workflows/ci.yml",
    "typecheck:tests": "tsc --project tsconfig.spec.json --noEmit"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "overrides": {
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource/heebo": "^5.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vitest": "^5.0.5"
  }
}
