{
  "name": "niva",
  "version": "0.3.5",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 127.0.0.1 --proxy-config proxy.conf.json",
    "build": "ng build && node scripts/write-build-info.mjs && node scripts/check-production-html.mjs && node scripts/build-worker.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "preview": "tsx server/migrate.ts && tsx server/index.ts",
    "format": "prettier --write src server scripts tests public/theme-init.js *.json *.ts README.md docs/implementation.md docs/accounts-map.md .github/workflows/ci.yml db drizzle/meta/*.json docs/pilot.md docs/career-assistant.md docs/verification/*.json docs/current-status.md docs/review-repairs-20261024.md CHANGELOG.md docs/review-repairs-20261025.md docs/staging-verification.md docs/screenshots/changes/review25-images.md",
    "format:check": "prettier --check src server scripts tests public/theme-init.js *.json *.ts README.md docs/implementation.md docs/accounts-map.md .github/workflows/ci.yml db drizzle/meta/*.json docs/pilot.md docs/career-assistant.md docs/verification/*.json docs/current-status.md docs/review-repairs-20261024.md CHANGELOG.md docs/review-repairs-20261025.md docs/staging-verification.md docs/screenshots/changes/review25-images.md",
    "typecheck:tests": "tsc --project tsconfig.spec.json --noEmit",
    "db:migrate": "tsx server/migrate.ts",
    "api": "tsx server/index.ts",
    "test:server": "vitest run --config vitest.server.config.ts",
    "test:worker": "node --test scripts/worker-runtime.test.mjs",
    "typecheck:server": "tsc --project tsconfig.server.json --noEmit",
    "typecheck:e2e": "tsc --project tsconfig.e2e.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "verify:career-sources": "tsx scripts/verify-career-sources.ts",
    "test:provenance": "node --test scripts/provenance.test.mjs",
    "test:safety": "vitest run --config vitest.server.config.ts server/repairs.spec.ts --reporter=json --outputFile=.test-data/synthetic-evaluation.json"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "overrides": {
    "vite": "^8.3.5",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.28.2"
    }
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource/heebo": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "better-auth": "^1.7.12",
    "drizzle-orm": "^0.45.4",
    "entities": "^8.1.0",
    "fflate": "^0.8.3",
    "hono": "^4.13.13",
    "leaflet": "^1.9.4",
    "nodemailer": "^10.2.1",
    "parse5": "^8.0.1",
    "pdfjs-dist": "^6.4.299",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261023.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "jose": "^6.2.13",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vitest": "^5.0.5"
  }
}
