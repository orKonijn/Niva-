# Server only. Copy to .env; never commit real values. Use Node 24.15+.
BETTER_AUTH_URL=http://127.0.0.1:4300
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
NIVA_DATA_DIR=.data
HOST=127.0.0.1
PORT=4300
# Local developer outbox only; prohibited in production. No real mail is sent.
NIVA_MAIL_MODE=local
# Production SMTP delivery; use a verified sender and keep credentials server-side.
SMTP_URL=
MAIL_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
# Signed Apple client-secret JWT; rotate before its expiry.
APPLE_CLIENT_SECRET=
# Hosted Sites Worker only; configure through the Sites secret store, never in hosting.json.
NIVA_IMPORT_SECRET=
# Sites custom-domain launch. Set only after ownership/DNS/TLS verification.
NIVA_PUBLIC_ORIGIN=
# Explicit alternative hostnames only; no wildcard or nameserver changes.
NIVA_REDIRECT_HOSTS=
NIVA_ALLOW_INDEXING=0

# Career extension: server only, optional. Sending stays disabled without BOTH values.
JSEARCH_API_KEY=
OPENAI_API_KEY=
NIVA_AI_MODEL=
# Existing Node server runs due ingestion every minute unless explicitly disabled.
NIVA_SCHEDULE_INGESTION=1
# For an authorized external hosted scheduler (32+ random characters).
NIVA_INGEST_SECRET=
# HTTPS isolated scan+parse service. Uploads remain disabled unless all are set.
NIVA_RESUME_PROCESSOR_URL=
NIVA_RESUME_PROCESSOR_KEY=
NIVA_RESUME_PROCESSOR_NAME=

# Optional independent watchdog. Remains inactive until an operator configures and runs it.
# NIVA_HEALTH_URL=https://STAGING_HOST/api/maintenance/health
# NIVA_OPERATOR_ID=REPLACE_WITH_APPROVED_OPERATOR_ALIAS
# NIVA_ALERT_URL=https://APPROVED_ALERT_RECEIVER
# NIVA_ALERT_SECRET=SERVER_ONLY_RECEIVER_TOKEN
# NIVA_WATCHDOG_STATE=.data/operator-watchdog.json
# NIVA_SITES_SERVICE_TOKEN=PRIVATE_SITE_UNATTENDED_CREDENTIAL_ONLY_FOR_HEALTH_SITE

# Optional hosted Google/Apple OAuth alongside ChatGPT. Separate owner identities; no implicit merge.
NIVA_AUTH_SECRET=
